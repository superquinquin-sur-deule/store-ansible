(function () {
  const err = [...document.querySelectorAll(".alert-danger")].find(
    (el) =>
      el.innerText.includes("Wrong login/password") ||
      el.innerText.includes("Mauvais nom d'utilisateur ou mot de passe"),
  );

  if (err)
    return console.error(`[Kiosk Auth] Aborted: ${err.innerText.trim()}`);

  const login = document.getElementById("login"),
    pass = document.getElementById("password"),
    form = document.querySelector(".oe_login_form");

  if (login && pass && form && !login.value) {
    login.value = "{{ odoo_addon_email }}";
    pass.value = "{{ odoo_addon_password }}";
    form.submit();
  }
})();

(function () {
  "use strict";
  const { open, send } = XMLHttpRequest.prototype;

  XMLHttpRequest.prototype.open = function (_, url) {
    this.isInvoice = typeof url === "string" && url.includes("action_invoice_download_pdf");
    return open.apply(this, arguments);
  };

  XMLHttpRequest.prototype.send = function () {
    if (!this.isInvoice) return send.apply(this, arguments);
    const orig = this.onreadystatechange;

    this.onreadystatechange = function () {
      if (this.readyState === 4 && this.status === 200) {
        try {
          const res = JSON.parse(this.responseText);
          res.result = { type: "ir.actions.act_window_close", context: {} };
          const payload = JSON.stringify(res);
          Object.defineProperties(this, { responseText: { value: payload, writable: true }, response: { value: payload, writable: true } });
        } catch (e) {}
      }
      if (orig) orig.apply(this, arguments);
    };
    return send.apply(this, arguments);
  };
})();
