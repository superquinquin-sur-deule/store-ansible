[Unit]
Description=Sway Wayland compositor on %I
After=systemd-user-sessions.service plymouth-quit-wait.service systemd-logind.service
Conflicts=getty@%I.service
ConditionPathExists=/dev/%I

[Service]
Type=simple
User=swaywm
Group=swaywm

PAMName=swaywm
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/%I
UtmpIdentifier=%I
UtmpMode=user

EnvironmentFile=/etc/default/swaywm
ExecStartPre=+/usr/local/bin/autokanshi --write-to /etc/kanshi/config
ExecStart=/usr/bin/sway --unsupported-gpu
Restart=always

[Install]
WantedBy=graphical.target
DefaultInstance=tty1
